{
    "name": "matatirosoln/doctrine-odata-driver",
    "description": "Doctrine DBAL driver for OData v4 backends, starting with FileMaker.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Steve Winter",
            "email": "steve@msdev.nz"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "doctrine/dbal": "^4.0",
        "matatirosoln/sql-to-odata": "^0.0.1",
        "psr/simple-cache": "^3.0",
        "symfony/http-client": "^7.0|^8.0",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Matatirosoln\\DoctrineOdataDriver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Matatirosoln\\DoctrineOdataDriver\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
